{
  "expo": {
    "name": "Rapidmedi Store",
    "slug": "rapidmedi-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "rapidmedi-store",
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rapidmedi.store",
      "infoPlist": {
        "NSCameraUsageDescription": "Rapidmedi needs camera access to capture your documents and medicine photos.",
        "NSPhotoLibraryUsageDescription": "Rapidmedi needs gallery access to attach an existing photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F9D6C"
      },
      "package": "com.rapidmedi.store",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F9D6C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rapidmedi needs gallery access to attach an existing photo.",
          "cameraPermission": "Rapidmedi needs camera access to capture your documents and medicine photos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Rapidmedi needs your location to set your store coordinates.",
          "locationWhenInUsePermission": "Rapidmedi needs your location to set your store coordinates."
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "firebaseApiKey": "AIzaSyDoqbjpy3pFiuvMCBhxffJH27bHBNaKTTA",
      "firebaseAuthDomain": "rapidmedi.firebaseapp.com",
      "firebaseProjectId": "rapidmedi",
      "firebaseStorageBucket": "rapidmedi.firebasestorage.app",
      "firebaseMessagingSenderId": "553213794552",
      "firebaseAppId": "1:553213794552:web:db1bdac54f2a80d791430d",
      "firebaseMeasurementId": "G-71EYHYR629",
      "eas": {
        "projectId": "b47b1b0d-6980-4312-92ee-20bcbf93abec"
      }
    },
    "owner": "arunkumar6684"
  }
}
