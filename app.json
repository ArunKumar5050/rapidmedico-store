{
  "expo": {
    "name": "RapidMedicoco Store",
    "slug": "rapidmedicoco-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "scheme": "rapidmedicoco-store",
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rapidmedicoco.store",
      "infoPlist": {
        "NSCameraUsageDescription": "RapidMedicoco needs camera access to capture your documents and medicine photos.",
        "NSPhotoLibraryUsageDescription": "RapidMedicoco needs gallery access to attach an existing photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0F9D6C"
      },
      "package": "com.rapidmedicoco.store",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F9D6C",
          "sounds": [
            "./assets/sounds/new_order_alert.mp3"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RapidMedicoco needs gallery access to attach an existing photo.",
          "cameraPermission": "RapidMedicoco needs camera access to capture your documents and medicine photos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RapidMedicoco needs your location to set your store coordinates.",
          "locationWhenInUsePermission": "RapidMedicoco needs your location to set your store coordinates."
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "firebaseApiKey": "AIzaSyDoqbjpy3pFiuvMCBhxffJH27bHBNaKTTA",
      "firebaseAuthDomain": "rapidmedico.firebaseapp.com",
      "firebaseProjectId": "rapidmedico",
      "firebaseStorageBucket": "rapidmedico.firebasestorage.app",
      "firebaseMessagingSenderId": "553213794552",
      "firebaseAppId": "1:553213794552:web:db1bdac54f2a80d791430d",
      "firebaseMeasurementId": "G-71EYHYR629",
      "eas": {
        "projectId": "f0743a69-78fb-4845-a338-99cac71b3f94"
      }
    },
    "owner": "arunkumar628"
  }
}
